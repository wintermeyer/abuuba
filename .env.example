# Copy to .env and fill in. `docker compose` reads it automatically.

# The hostname this instance is reachable at, and the domain in every account
# address. They are usually the same.
#
# LOCAL_DOMAIN is written into every id this server publishes, so changing it
# on a running instance orphans everything already federated. Decide it once.
PHX_HOST=social.example.com
LOCAL_DOMAIN=social.example.com

# openssl rand -base64 48
#
# It goes into DATABASE_URL as part of a URL, so keep it to letters and digits:
# a `/`, `@`, `#` or `?` in it changes where the URL says the database is, and
# the resulting error names a host you have never heard of.
POSTGRES_PASSWORD=

# The key Phoenix signs sessions and tokens with.
#   docker compose run --rm abuuba bin/abuuba eval 'IO.puts(:crypto.strong_rand_bytes(48) |> Base.encode64())'
SECRET_KEY_BASE=

# The key private keys and OTP secrets are encrypted with, base64, exactly 32
# bytes decoded. Losing it makes every encrypted column unreadable, and there
# is no recovery from that: back it up somewhere other than this host.
#   openssl rand -base64 32
CLOAK_KEY=

# Mail. Confirmations and password resets go out over this, so an instance
# that cannot send it cannot sign anybody up.
#
# MAIL_ADAPTER is `smtp` (the default), `mailgun`, or `local`. The last one
# delivers nothing and is only for trying the software out.
MAIL_FROM=noreply@social.example.com
SMTP_RELAY=mail.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Database connections per abuuba container. Room for it has to exist in
# Postgres's own max_connections.
POOL_SIZE=10

# Pin a version rather than tracking a moving tag, so a restart is never a
# surprise upgrade. `edge` is the current main and is what exists before the
# first release; `1.2.3` and `latest` appear once a v1.2.3 tag is cut.
ABUUBA_VERSION=edge

# Taking over a Mastodon instance, and only then. Fill these in, uncomment the
# matching block in docker-compose.yml, run the import, then delete both again.
# What a takeover moves and what it leaves behind:
# docs/admin/importing-from-mastodon.md
#
# The last six are the old server's own secrets, copied out of its environment:
# rows come across with columns Rails encrypted in them. Every name here keeps
# its MASTODON_ prefix, which is what tells its SECRET_KEY_BASE apart from the
# one above, and there is no falling back to the bare name.
#
# MASTODON_DATABASE_URL=postgres://mastodon:secret@10.0.0.2/mastodon_production
# MASTODON_LOCAL_DOMAIN=social.example.com
# MASTODON_MEDIA_ROOT=/mastodon-media      # where the mount lands, not the host path
# MASTODON_S3_BUCKET=                      # instead of the mount, if media is in a bucket
# MASTODON_SECRET_KEY_BASE=
# MASTODON_ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# MASTODON_ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# MASTODON_ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
# MASTODON_VAPID_PRIVATE_KEY=
# MASTODON_VAPID_PUBLIC_KEY=
