<!DOCTYPE html>
<html lang={Abuuba.I18n.default_locale()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{@status["account"]["acct"]}</title>
    <link rel="stylesheet" href={~p"/assets/css/app.css"} />
  </head>
  <body class="bg-base-100">
    <article class="p-4">
      <p class="text-sm">
        <span class="font-semibold">{@author.display_name}</span>
        <span class="text-base-content/60">@{@status["account"]["acct"]}</span>
      </p>

      <div :if={@status["spoiler_text"] not in [nil, ""]} class="mt-2">
        <details>
          <summary class="cursor-pointer rounded bg-base-200 px-3 py-2">
            {@status["spoiler_text"]}
          </summary>
          <div class="mt-2 break-words">{raw(@status["content"])}</div>
        </details>
      </div>

      <div :if={@status["spoiler_text"] in [nil, ""]} class="mt-2 break-words">
        {raw(@status["content"])}
      </div>

      <p class="mt-3 text-sm">
        <a href={@status["url"]} target="_blank" rel="noopener" class="link">
          {gettext("Read this on %{server}", server: Abuuba.Instance.software_name())}
        </a>
      </p>
    </article>
  </body>
</html>
