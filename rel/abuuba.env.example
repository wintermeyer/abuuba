# /etc/abuuba/abuuba.env — chmod 600, owned by root.
#
# Same variables as .env.example, in systemd's EnvironmentFile format: KEY=value,
# no quoting, no shell expansion.

PHX_HOST=social.example.com
LOCAL_DOMAIN=social.example.com
PORT=4000

DATABASE_URL=ecto://abuuba:PASSWORD@localhost/abuuba
POOL_SIZE=10

SECRET_KEY_BASE=
CLOAK_KEY=

MEDIA_ROOT=/var/lib/abuuba/uploads

# How many Erlang schedulers to run. Left unset, the release counts the
# container's CPU quota, or the machine's cores when there is no quota. Set it
# only to override that.
# ABUUBA_SCHEDULERS=2

# Scheduler busy-wait. Off by default: an idle server otherwise spins several
# cores doing nothing. Set to 1 to restore the VM default, which trades that
# idle CPU for roughly a millisecond off each request. See docs/deploy.md.
# ABUUBA_SCHEDULER_BUSY_WAIT=1

MAIL_FROM=noreply@social.example.com
SMTP_RELAY=mail.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
