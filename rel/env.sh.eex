#!/bin/sh
# What a release needs to know before it starts, and what it must never assume.
#
# Read by `bin/abuuba` on every command, including `eval` and `rpc`, which is why
# the node name is set here rather than in the start script: a migration run
# with `bin/abuuba eval` needs a name too, and one that clashes with the running
# server's takes the server down.

# A short name by default, because the common deployment is one machine and a
# short name needs no DNS to be resolvable. Set RELEASE_DISTRIBUTION=name and
# RELEASE_NODE=abuuba@your.host to run more than one node.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-sname}"
export RELEASE_NODE="${RELEASE_NODE:-abuuba}"

# `eval` starts a node of its own, so it gets a name of its own: an operator
# running a migration while the server is up would otherwise start a second
# node with the same name, and the collision reads as the command hanging.
#
# Not `rpc` and not `remote`. For those, RELEASE_NODE names the node to connect
# *to*, and renaming it means connecting to nothing — which is how a container
# healthcheck ends up reporting an unreachable node forever while the server it
# is running inside serves fine.
if [ "${RELEASE_COMMAND}" = "eval" ]; then
  export RELEASE_NODE="${RELEASE_NODE}-eval-$$"
fi

# How much of the machine the VM is allowed to think it has, and how hard it
# spins when it has nothing to do. Both defaults are wrong in a container.
#
# Scheduler busy-wait: a scheduler with no work spins before it sleeps, so the
# next job does not pay a wake-up. On a machine dedicated to one busy node that
# is a good trade. Everywhere else it is invisible CPU burn that looks exactly
# like load — an idle abuuba was measured taking four to five cores in bursts,
# with no request in flight and Postgres at zero.
#
# `very_short` rather than `none`, measured back to back on one container with
# the same data (96-core host, home timeline p50, idle CPU peak):
#
#   medium (the VM default)   5.59 ms    487%
#   very_short                5.98 ms     89%
#   none                      6.26 ms     79%
#
# `none` buys almost nothing more than `very_short` and costs twice as much
# latency for it. Set ABUUBA_SCHEDULER_BUSY_WAIT=1 to keep the VM's default,
# which is the right choice on hardware abuuba has to itself.
if [ "${ABUUBA_SCHEDULER_BUSY_WAIT:-0}" != "1" ]; then
  export ERL_ZFLAGS="${ERL_ZFLAGS:-} +sbwt very_short +sbwtdcpu very_short +sbwtdio very_short"
fi

# Scheduler count: the VM counts the host's logical processors and starts one
# scheduler per core. It does not read cgroup limits, so a container held to
# two CPUs on a large host still starts a scheduler per host core, and they all
# contend for the two cores the container actually has.
#
# cgroup v2 first, then v1. "max" means no quota, and no quota means the VM's
# own count is the right one, so nothing is set.
# The two cgroup versions differ only in how "no quota" is spelled: `max` in
# v2, `-1` in v1. Normalise that, then one guard and one calculation.
if [ -z "${ABUUBA_SCHEDULERS:-}" ]; then
  if [ -r /sys/fs/cgroup/cpu.max ]; then
    read -r _quota _period < /sys/fs/cgroup/cpu.max
    [ "${_quota}" = "max" ] && _quota=-1
  elif [ -r /sys/fs/cgroup/cpu/cpu.cfs_quota_us ]; then
    _quota="$(cat /sys/fs/cgroup/cpu/cpu.cfs_quota_us)"
    _period="$(cat /sys/fs/cgroup/cpu/cpu.cfs_period_us)"
  fi

  # Rounded up, so a fractional quota still gets a whole scheduler.
  if [ "${_quota:-0}" -gt 0 ] 2>/dev/null && [ "${_period:-0}" -gt 0 ] 2>/dev/null; then
    ABUUBA_SCHEDULERS=$(( (_quota + _period - 1) / _period ))
  fi
fi

# One scheduler is a deadlock waiting to happen the first time something busy
# blocks, so the floor is two.
if [ -n "${ABUUBA_SCHEDULERS:-}" ]; then
  [ "${ABUUBA_SCHEDULERS}" -lt 2 ] && ABUUBA_SCHEDULERS=2
  export ERL_ZFLAGS="${ERL_ZFLAGS:-} +S ${ABUUBA_SCHEDULERS}:${ABUUBA_SCHEDULERS} +SDcpu ${ABUUBA_SCHEDULERS}:${ABUUBA_SCHEDULERS}"
fi
